{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "totp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-04",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "totp.gillfamily.co.nz",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
